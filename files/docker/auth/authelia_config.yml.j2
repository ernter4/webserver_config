
access_control:
  default_policy: deny
  rules:
      - domain: '*.{{apex_domain}}'
        policy: one_factor
authentication_backend:
  refresh_interval: '5m'
  password_reset:
       disable: true
  ldap:
    implementation: 'lldap'
    address: 'ldap://lldap:3890'
    base_dn: '{{LLDAP_LDAP_BASE_DN}}'
    user: 'UID=authelia,OU=people,DC=lamm-harburg,DC=de'
storage:
  local:
    path: '/config/db.sqlite3'
session:
  cookies:
      - domain: '{{apex_domain}}'
        authelia_url: 'https://auth.{{apex_domain}}'

notifier:
  filesystem:
    filename: /config/notification.txt
    